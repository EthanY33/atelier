{
  "name": "atelier",
  "version": "1.1.0",
  "private": true,
  "description": "Design-automation plugin for Claude Code: eight skills around one brand file.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanY33/atelier.git"
  },
  "author": "Ethan Yucetepe",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm ci --prefix plugins/atelier --no-audit --no-fund",
    "setup:browsers": "npm exec --prefix plugins/atelier -- playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:schemas": "node scripts/validate-schemas.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "smoke:plugin": "node scripts/smoke-installed-plugin.mjs",
    "demo": "node plugins/atelier/bin/atelier demo --out .atelier-demo",
    "demo:trailer": "node scripts/trailer/build.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "vitest": "5.0.1"
  }
}
