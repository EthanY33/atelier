{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EthanY33/atelier/main/plugins/atelier/schemas/brand.schema.json",
  "title": "Atelier Brand Memory",
  "description": "Brand source of truth for the atelier design-automation plugin.",
  "type": "object",
  "required": [
    "brand",
    "palette",
    "typography"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema URL for editor autocomplete. Ignored by atelier."
    },
    "brand": {
      "type": "object",
      "required": [
        "studio"
      ],
      "additionalProperties": false,
      "properties": {
        "studio": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string"
        },
        "voice": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_-]*$": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^<>{};\\\\\\u0000-\\u001F\\u007F-\\u009F]*$",
          "description": "CSS font-family stack. < > { } ; backslash and control characters are rejected."
        },
        "display": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^[^<>{};\\\\\\u0000-\\u001F\\u007F-\\u009F]*$",
          "description": "CSS font-family stack. < > { } ; backslash and control characters are rejected."
        },
        "mono": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^[^<>{};\\\\\\u0000-\\u001F\\u007F-\\u009F]*$",
          "description": "CSS font-family stack. < > { } ; backslash and control characters are rejected."
        }
      }
    },
    "logos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mark": {
          "type": "string"
        },
        "wordmark": {
          "type": "string"
        }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "cloudflare-pages",
            "netlify",
            "github-pages",
            "vercel",
            "custom"
          ]
        },
        "project": {
          "type": "string"
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "steam",
              "itch",
              "apple",
              "google"
            ]
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "description": "Motion tokens. runtime-ux-audit compares panel transition durations against them.",
      "properties": {
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]*$": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?(ms|s)$"
            }
          }
        },
        "easing": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]*$": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "description": "Surface tokens. zIndexMax is the z-index above which runtime-ux-audit flags a layer.",
      "properties": {
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]*$": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?(px|rem|em|%)$"
            }
          }
        },
        "elevation": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_-]*$": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        "zIndexMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-project budgets for runtime-ux-audit. Defaults: minTapPx 24 (WCAG 2.2), inpBudgetMs 200.",
      "properties": {
        "minTapPx": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "inpBudgetMs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "lcpBudgetMs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60000
        },
        "clsBudget": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  }
}
